package-as: GlassMiniMap

enable-nolib-creation: no

# The glass material. Pinned, never `tag: latest` (the packager picks the
# newest tag by creation date and falls back to the branch HEAD). CI reads the
# pin from here, so it is written once.
#
# No comment on a value line: the packager's YAML reader keeps it as part of
# the value (measured in GlassUnitFrames #64).
externals:
  Libs/LibGlass-1.0:
    url: https://github.com/Spotnick2/LibGlass
    tag: r9

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# CurseForge relations, set on every release (CurseForge project slugs).
# Glass MiniMap Bar is the addon drawer: optional (## OptionalDeps in the TOC).
optional-dependencies:
  - glass-minimap-bar

# YAML list, not markdown bullets. Every pattern matches the WHOLE path from
# the package root, so the top-level names below never reach inside Libs/:
# Libs/LibGlass-1.0/LICENSE ships (MIT). Our LICENSE ships too (GPLv3 asks for it).
ignore:
  - .github
  - .claude
  - docs
  - tests
  - Tools
  - CLAUDE.md
  - README.md
  - CHANGELOG.md
  # The library's own .pkgmeta ignores these, but CurseForge's packager does
  # NOT honour an external's ignore list (Priestly #53), so they are named here.
  - Libs/LibGlass-1.0/tests
  - Libs/LibGlass-1.0/docs
  - Libs/LibGlass-1.0/Tools
  - Libs/LibGlass-1.0/AGENTS.md
  - Libs/LibGlass-1.0/CLAUDE.md
  - Libs/LibGlass-1.0/README.md
